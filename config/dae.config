# Shared additive fragment for the pinned MU300 6.18.54 and 7.2.8 builds.
# Every requested value, including n, must match the generated final .config.
CONFIG_LOCALVERSION="-f50-dae1"
CONFIG_LOCALVERSION_AUTO=n

# dae's BPF/TC/cgroup datapath. Keep features built in: the bundle copies vendor ko only.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
# Fix runtime JIT on for this candidate; stronger than dae's minimum requirement.
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_INGRESS=y
CONFIG_NET_EGRESS=y
CONFIG_NET_SOCK_MSG=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_VETH=y

# Official trace support; not a claim that all tracing is mandatory for default dae run.
CONFIG_DEBUG_KERNEL=y
CONFIG_KALLSYMS=y
CONFIG_PERF_EVENTS=y
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
CONFIG_TRACING=y

# Select DWARF4 explicitly for a stable debug format across both toolchain builds.
# The build environment must provide pahole >= 1.22 for both kernel versions.
CONFIG_DEBUG_INFO_NONE=n
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=n
CONFIG_DEBUG_INFO_DWARF4=y
CONFIG_DEBUG_INFO_DWARF5=n
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_REDUCED=n
CONFIG_DEBUG_INFO_SPLIT=n
CONFIG_DEBUG_INFO_BTF=y
CONFIG_MODULES=y
# dae consumes vmlinux BTF; vendor modules do not require split module BTF.
CONFIG_DEBUG_INFO_BTF_MODULES=n

# Package-level networking requirements, separate from dae's minimum core datapath.
CONFIG_NET_ACT_BPF=y
CONFIG_XDP_SOCKETS=y
CONFIG_XDP_SOCKETS_DIAG=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TPROXY_IPV4=y
CONFIG_NF_TPROXY_IPV6=y
CONFIG_NFT_TPROXY=y

# Expose the exact running configuration at /proc/config.gz for device acceptance.
CONFIG_PROC_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
