+//! Narrow compatibility adapter for the F50's verified SIPA WAN interface.
+
+use anyhow::Context;
+use std::path::Path;
+
+const F50_SIPA_INTERFACE: &str = "sipa_eth0";
+const ARPHRD_RAWIP: u32 = 519;
+const ETHERNET_ADDRESS_LEN: u32 = 6;
+const L2_PROGRAMS: (&str, &str) = ("wan_ingress_l2", "wan_egress_l2");
+const L3_PROGRAMS: (&str, &str) = ("wan_ingress_l3", "wan_egress_l3");
+const SIPA_PROGRAMS: (&str, &str) = ("wan_ingress_sipa", "wan_egress_l2");
+
+pub(super) fn wan_program_pair(
+    interface: &str,
+    ethernet: bool,
+) -> anyhow::Result<(&'static str, &'static str)> {
+    let programs = program_pair(interface, ethernet, Path::new("/sys"))?;
+    if programs == SIPA_PROGRAMS {
+        tracing::info!(
+            interface,
+            ingress = programs.0,
+            egress = programs.1,
+            "Using verified F50 SIPA framing: Ethernet RX/TX and RAWIP reply reinjection"
+        );
+    }
+    Ok(programs)
+}
+
+fn program_pair(
+    interface: &str,
+    ethernet: bool,
+    sysfs: &Path,
+) -> anyhow::Result<(&'static str, &'static str)> {
+    if ethernet {
+        return Ok(L2_PROGRAMS);
+    }
+    if interface != F50_SIPA_INTERFACE {
+        return Ok(L3_PROGRAMS);
+    }
+    let device = sysfs.join("class/net").join(interface);
+    let kind = read_number(&device.join("type"))?;
+    let address_len = read_number(&device.join("addr_len"))?;
+    anyhow::ensure!(
+        kind == ARPHRD_RAWIP && address_len == ETHERNET_ADDRESS_LEN,
+        "F50 SIPA interface identity mismatch: type={kind}, addr_len={address_len}"
+    );
+    anyhow::ensure!(
+        sysfs.join("module/sipa_eth").is_dir()
+            && sysfs.join("kernel/debug/sipa_eth").join(interface).is_dir(),
+        "F50 SIPA driver evidence missing: require /sys/module/sipa_eth and per-interface debugfs directory"
+    );
+    Ok(SIPA_PROGRAMS)
+}
+
+fn read_number(path: &Path) -> anyhow::Result<u32> {
+    std::fs::read_to_string(path)
+        .with_context(|| format!("read F50 SIPA identity {}", path.display()))?
+        .trim()
+        .parse()
+        .with_context(|| format!("parse F50 SIPA identity {}", path.display()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn fixture() -> tempfile::TempDir {
+        let root = tempfile::tempdir().unwrap();
+        let interface = root.path().join("class/net/sipa_eth0");
+        std::fs::create_dir_all(&interface).unwrap();
+        std::fs::write(interface.join("type"), "519\n").unwrap();
+        std::fs::write(interface.join("addr_len"), "6\n").unwrap();
+        std::fs::create_dir_all(root.path().join("module/sipa_eth")).unwrap();
+        std::fs::create_dir_all(root.path().join("kernel/debug/sipa_eth/sipa_eth0")).unwrap();
+        root
+    }
+
+    #[test]
+    fn verified_f50_sipa_selects_mixed_rx_and_ethernet_tx() {
+        let root = fixture();
+        assert_eq!(
+            program_pair("sipa_eth0", false, root.path()).unwrap(),
+            ("wan_ingress_sipa", "wan_egress_l2")
+        );
+    }
+
+    #[test]
+    fn other_rawip_and_ethernet_interfaces_keep_existing_programs() {
+        let root = fixture();
+        for interface in ["wwan0", "tun0", "ppp0", "sipa_eth1", "sipa_eth0extra"] {
+            assert_eq!(
+                program_pair(interface, false, root.path()).unwrap(),
+                L3_PROGRAMS
+            );
+        }
+        assert_eq!(
+            program_pair("eth0", true, root.path()).unwrap(),
+            L2_PROGRAMS
+        );
+    }
+
+    #[test]
+    fn mismatched_sipa_identity_is_rejected() {
+        let root = fixture();
+        let interface = root.path().join("class/net/sipa_eth0");
+        std::fs::write(interface.join("type"), "65534\n").unwrap();
+        assert!(program_pair("sipa_eth0", false, root.path()).is_err());
+        std::fs::write(interface.join("type"), "519\n").unwrap();
+        std::fs::write(interface.join("addr_len"), "0\n").unwrap();
+        assert!(program_pair("sipa_eth0", false, root.path()).is_err());
+    }
+
+    #[test]
+    fn module_and_per_interface_driver_evidence_are_required() {
+        let root = fixture();
+        let module = root.path().join("module/sipa_eth");
+        std::fs::remove_dir(&module).unwrap();
+        assert!(program_pair("sipa_eth0", false, root.path()).is_err());
+        std::fs::create_dir(&module).unwrap();
+        std::fs::remove_dir(root.path().join("kernel/debug/sipa_eth/sipa_eth0")).unwrap();
+        assert!(program_pair("sipa_eth0", false, root.path()).is_err());
+    }
+
+    #[test]
+    fn unreadable_sipa_identity_is_an_error() {
+        let root = fixture();
+        std::fs::remove_file(root.path().join("class/net/sipa_eth0/type")).unwrap();
+        assert!(program_pair("sipa_eth0", false, root.path()).is_err());
+    }
+}
