+//! SIPA native RX has pseudo-Ethernet framing; BPF-reinjected replies are RAWIP.
+
+use aya_ebpf::programs::TcContext;
+use aya_ebpf_bindings::bindings::__sk_buff;
+use honk_ebpf_common::sipa::{SIPA_PREFIX_LEN, SipaFrameError, ingress_link_header_len};
+
+use crate::action::{TC_ACT_OK, TC_ACT_SHOT, Verdict, flatten};
+
+#[inline(always)]
+fn ingress(ctx: &TcContext) -> Verdict {
+    let prefix = ctx
+        .load::<[u8; SIPA_PREFIX_LEN]>(0)
+        .map_err(|_| TC_ACT_SHOT)?;
+    let protocol = u16::from_be(ctx.skb.protocol() as u16);
+    match ingress_link_header_len(&prefix, protocol) {
+        Ok(header_len) => crate::ingress::do_tproxy_wan_ingress(ctx, header_len),
+        Err(SipaFrameError::UnsupportedProtocol) => Ok(TC_ACT_OK),
+        Err(SipaFrameError::InvalidHeader) => Err(TC_ACT_SHOT),
+    }
+}
+
+#[unsafe(no_mangle)]
+#[unsafe(link_section = "classifier")]
+pub fn wan_ingress_sipa(ctx: *mut __sk_buff) -> i32 {
+    flatten(ingress(&TcContext::new(ctx)))
+}
