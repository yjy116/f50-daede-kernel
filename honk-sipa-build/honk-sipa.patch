+//! Framing contract for the verified F50 SIPA driver and RAWIP BPF reinjection.
+
+pub const ETHERNET_HEADER_LEN: u32 = 14;
+pub const SIPA_PREFIX_LEN: usize = ETHERNET_HEADER_LEN as usize + 1;
+pub const ETH_P_IPV4: u16 = 0x0800;
+pub const ETH_P_IPV6: u16 = 0x86dd;
+const SIPA_DESTINATION: [u8; 6] = [0x16, 0x15, 0x14, 0x13, 0x12, 0x11];
+const SIPA_SOURCE: [u8; 6] = [0x11, 0x12, 0x13, 0x14, 0x15, 0x16];
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum SipaFrameError {
+    UnsupportedProtocol,
+    InvalidHeader,
+}
+
+/// Accept only native SIPA pseudo-Ethernet or protocol-matching RAWIP replies.
+#[inline(always)]
+pub fn ingress_link_header_len(
+    prefix: &[u8; SIPA_PREFIX_LEN],
+    protocol: u16,
+) -> Result<u32, SipaFrameError> {
+    let version = match protocol {
+        ETH_P_IPV4 => 4,
+        ETH_P_IPV6 => 6,
+        _ => return Err(SipaFrameError::UnsupportedProtocol),
+    };
+    // __bpf_redirect_no_mac strips the header when dae0 targets a RAWIP device.
+    if prefix[0] >> 4 == version {
+        return Ok(0);
+    }
+    if prefix[..6] == SIPA_DESTINATION
+        && prefix[6..12] == SIPA_SOURCE
+        && u16::from_be_bytes([prefix[12], prefix[13]]) == protocol
+        && prefix[ETHERNET_HEADER_LEN as usize] >> 4 == version
+    {
+        return Ok(ETHERNET_HEADER_LEN);
+    }
+    Err(SipaFrameError::InvalidHeader)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn native_prefix(protocol: u16) -> [u8; SIPA_PREFIX_LEN] {
+        let mut prefix = [
+            0x16, 0x15, 0x14, 0x13, 0x12, 0x11, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0, 0, 0,
+        ];
+        prefix[12..14].copy_from_slice(&protocol.to_be_bytes());
+        prefix[14] = if protocol == ETH_P_IPV4 { 0x45 } else { 0x60 };
+        prefix
+    }
+
+    #[test]
+    fn native_sipa_ipv4_and_ipv6_keep_ethernet_header() {
+        for protocol in [ETH_P_IPV4, ETH_P_IPV6] {
+            assert_eq!(
+                ingress_link_header_len(&native_prefix(protocol), protocol),
+                Ok(14)
+            );
+        }
+    }
+
+    #[test]
+    fn redirected_ipv4_and_ipv6_are_raw_ip() {
+        for (protocol, version) in [(ETH_P_IPV4, 0x45), (ETH_P_IPV6, 0x60)] {
+            let mut prefix = [0; SIPA_PREFIX_LEN];
+            prefix[0] = version;
+            assert_eq!(ingress_link_header_len(&prefix, protocol), Ok(0));
+        }
+    }
+
+    #[test]
+    fn raw_ipv4_source_address_is_not_mistaken_for_ether_type() {
+        let mut prefix = [0; SIPA_PREFIX_LEN];
+        prefix[0] = 0x45;
+        prefix[12..15].copy_from_slice(&[8, 0, 64]);
+        assert_eq!(ingress_link_header_len(&prefix, ETH_P_IPV4), Ok(0));
+    }
+
+    #[test]
+    fn arbitrary_ethernet_mac_is_not_accepted_as_sipa() {
+        let mut prefix = native_prefix(ETH_P_IPV4);
+        prefix[0] = 0x02;
+        assert_eq!(
+            ingress_link_header_len(&prefix, ETH_P_IPV4),
+            Err(SipaFrameError::InvalidHeader)
+        );
+    }
+
+    #[test]
+    fn protocol_and_ip_version_must_agree() {
+        let mut prefix = native_prefix(ETH_P_IPV4);
+        prefix[14] = 0x60;
+        assert_eq!(
+            ingress_link_header_len(&prefix, ETH_P_IPV4),
+            Err(SipaFrameError::InvalidHeader)
+        );
+        prefix[0] = 0x45;
+        assert_eq!(
+            ingress_link_header_len(&prefix, ETH_P_IPV6),
+            Err(SipaFrameError::InvalidHeader)
+        );
+    }
+
+    #[test]
+    fn inconsistent_ether_type_and_unsupported_protocol_are_explicit() {
+        let prefix = native_prefix(ETH_P_IPV6);
+        assert_eq!(
+            ingress_link_header_len(&prefix, ETH_P_IPV4),
+            Err(SipaFrameError::InvalidHeader)
+        );
+        assert_eq!(
+            ingress_link_header_len(&prefix, 0x0806),
+            Err(SipaFrameError::UnsupportedProtocol)
+        );
+    }
+}
