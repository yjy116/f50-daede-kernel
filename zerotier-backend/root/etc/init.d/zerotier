#!/bin/sh /etc/rc.common
# F50 p2: official 1.16 daemon; explicit UCI network enable and owned fw4 data.
START=90
USE_PROCD=1
PROG=/usr/bin/zerotier-one
ZT_RUNTIME=/var/lib/zerotier-one
ZT_STATE=/etc/zerotier-f50
umask 077
. /usr/libexec/zerotier-f50/config.sh
. /usr/libexec/zerotier-f50/networks.sh

start_service() {
	ZT_START_RESULT=1
	config_load zerotier || return 1
	zt_validate_global || return 1
	[ "$ZT_ENABLED" = 1 ] || { ZT_START_RESULT=0; echo 'disabled in /etc/config/zerotier'; return 0; }
	zt_prepare_runtime && zt_prepare_identity || {
		logger -t zerotier-f50 'Startup preparation failed; daemon was not started'
		return 1
	}
	procd_open_instance
	procd_set_param command "$PROG"
	[ -z "$ZT_PORT" ] || procd_append_param command "-p$ZT_PORT"
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance || return 1
	ZT_START_RESULT=0
}

service_data() {
	# procd owns this service data; neither zones nor persistent firewall UCI are changed.
	json_add_array firewall
	json_close_array
}

service_started() {
	# rc.common otherwise replaces start_service's failure status with procd_close_service's result.
	[ "${ZT_START_RESULT:-1}" = 0 ] || return 1
	[ "$ZT_ENABLED" = 1 ] || return 0
	/usr/libexec/zerotier-f50-firewall refresh &
}

stop_service() {
	ZT_STOP_RESULT=0
	rm -rf "$ZT_RUNTIME" || {
		ZT_STOP_RESULT=1
		logger -t zerotier-f50 'Could not remove runtime directory'
		return 1
	}
}

service_stopped() {
	# procd has deleted the service data by this callback; reload must not read stale rules.
	fw4 reload || {
		logger -t zerotier-f50 'Firewall reload failed after ZeroTier stopped'
		return 1
	}
	[ "${ZT_STOP_RESULT:-0}" = 0 ]
}

reload_service() {
	stop && start
}

service_triggers() {
	procd_add_reload_trigger zerotier
}
