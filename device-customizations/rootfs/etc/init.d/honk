#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10
SHUTDOWN_GRACE_SECONDS=60

start_service() {
    /sbin/modprobe nfnetlink_queue || return 1
    /sbin/modprobe nft_queue || return 1
    procd_open_instance
    procd_set_param command /usr/bin/honk-core --config /etc/honk/config.dae \
        --data-dir /etc/honk/data --disable-timestamp
    procd_set_param env DAE_LOCATION_ASSET=/usr/share/v2ray
    procd_set_param limits nofile="1048576 1048576" memlock="unlimited"
    # Allow Honk to drain sessions and detach its owned kernel hooks.
    procd_set_param term_timeout "$SHUTDOWN_GRACE_SECONDS"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    /usr/bin/honk-core reload
}
